# Copy the values you need into the hosting dashboard (or a local .env that is never committed).
# None of these is required for the default build, which uses the rule-based stand-in.

# Build time, read by Vite: use the hosted model through the relay.
VITE_MODEL=relay

# Relay only. These never reach the browser; never prefix them with VITE_.
MODEL_API_URL=https://hyper.charm.land/v1/chat/completions
MODEL_API_KEY=
MODEL_ID=glm-5.3-flash
# 0 makes the model copy figures from tool results exactly (see the live-model report linked in README.md).
MODEL_TEMPERATURE=0

# Optional: model requests one client may make per minute (default 30).
RELAY_RATE_LIMIT=30
